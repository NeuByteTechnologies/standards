<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg
   width="210mm"
   height="297mm"
   viewBox="0 0 210 297"
   version="1.1"
   id="svg5"
   xmlns="http://www.w3.org/2000/svg"
   xmlns:inkscape="http://www.inkscape.org/namespaces/inkscape"
   xmlns:sodipodi="http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd">

  <sodipodi:namedview
     id="namedview7"
     pagecolor="#ffffff"
     bordercolor="#666666"
     borderopacity="1.0"
     inkscape:pageshadow="2"
     inkscape:pageopacity="0.0"
     inkscape:document-units="px"
     inkscape:zoom="1"
     inkscape:cx="0"
     inkscape:cy="0"
     inkscape:current-layer="layer1"
     showgrid="false" />

  <!-- Default NeuByte Styles -->
<style id="neubyte-default-style" type="text/css"><![CDATA[
    /* ============================
       NeuByte Default Typography
       ============================ */
    text, tspan {
        font-family: 'Manrope', sans-serif;
        font-size: 12pt;
        fill: #1A1A1A;
        line-height: 1.2;
    }

    /* Title text */
    .diagram-title {
        font-size: 18pt;
        font-weight: 600;
        text-anchor: middle;
        fill: #1A1A1A;
    }

    /* ============================
       NeuByte Stroke Standards
       ============================ */
    line, path {
        stroke: #000000;
        stroke-width: 1.0px;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

    /* Swimlane dividers */
    .divider {
        stroke: #BFBFBF;
        stroke-width: 0.8px;
    }

    /* Activation bars */
    .activation {
        fill: #EAEAEA;
        stroke: none;
    }

    /* ============================
       NeuByte Shapes
       ============================ */
    rect {
        fill: #FFFFFF;
        stroke: #000000;
        stroke-width: 1.0px;
    }

    /* Database cylinder */
    .database {
        fill: #F5F5F5;
        stroke: #000000;
        stroke-width: 1.0px;
    }

    /* End marker */
    .end-node {
        fill: #000000;
        stroke: none;
    }

    /* ============================
       Arrowheads
       ============================ */
    .arrow {
        marker-end: url(#Triangle);
    }
]]></style>


  <g id="layer1" inkscape:groupmode="layer" inkscape:label="Layer 1">
    <!-- Blank default layer -->
  </g>

</svg>
